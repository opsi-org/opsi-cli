[Actions]
requiredOpsiScriptVersion >= "4.12.4.35"

DefFunc uninstall_windows() : void
	Message "uninstalling opsi-cli on windows"
	ShellCall('"%ScriptPath%\opsi-cli-windows-x86_64.exe" -l 6 self uninstall --location=system')
	if not(GetLastExitcode = "0") or fileexists("c:\opsi.org\opsi-cli\opsi-cli.exe")
		LogError "opsi-cli self uninstall failed"
		IsFatalError "opsi-cli self uninstall failed"
	endif
EndFunc

DefFunc uninstall_linux() : void
	Message "uninstalling opsi-cli on linux"
	files_copy_to_temp_linux
	ShellCall('chmod 755 /tmp/opsi-cli-linux-x64.run')
	ShellCall("/tmp/opsi-cli-linux-x64.run -l 6 self uninstall --location=system")
	if not(GetLastExitcode = "0") or fileexists("/usr/local/bin/opsi-cli")
		LogError "opsi-cli self uninstall failed"
		IsFatalError "opsi-cli self uninstall failed"
	endif

	[files_copy_to_temp_linux]
	copy "%ScriptPath%/opsi-cli-linux-x64.run" "/tmp/"
EndFunc

DefFunc uninstall_macos() : void
	Message "uninstalling opsi-cli on macos"
	files_copy_to_temp_macos
	ShellCall('chmod 755 /tmp/opsi-cli-macos-x64')
	ShellCall("/tmp/opsi-cli-macos-x64 -l 6 self uninstall --location=system")
	if not(GetLastExitcode = "0") or fileexists("/usr/local/bin/opsi-cli")
		LogError "opsi-cli self uninstall failed"
		IsFatalError "opsi-cli self uninstall failed"
	endif

	[files_copy_to_temp_macos]
	copy "%ScriptPath%/opsi-cli-macos-x64" "/tmp/"
EndFunc


Switch GetOS
	Case "Windows_NT"
		uninstall_windows()
	EndCase
	Case "Linux"
		uninstall_linux()
	EndCase
	Case "macOS"
		uninstall_macos()
	EndCase
EndSwitch
